# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA...

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Контакт поддержки, показывается клиентам (например @Fred_service)
SUPPORT_CONTACT=@Fred_service

# Пути установки OpenVPN (так ставит scripts/openvpn-install.sh)
OPENVPN_DIR=/etc/openvpn
EASYRSA_DIR=/etc/openvpn/easy-rsa

# Автоматически следить за сменой IP и рассылать новые ключи
IP_AUTO_UPDATE=true
# Как часто проверять IP (секунды)
IP_CHECK_INTERVAL=60
# Сколько проверок подряд новый IP должен подтвердиться (защита от ложных срабатываний)
IP_CONFIRM_CHECKS=2

# За сколько дней предупреждать клиента об окончании ключа (0 — не предупреждать)
WARN_DAYS=3
